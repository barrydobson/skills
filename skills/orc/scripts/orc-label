#!/usr/bin/env bash
# Set the labels on an orc session's own terminal that a Herdr panel can read to show the run.
# The Orc panel (herdr-mods, mods/orc-runs) reads these keys; orch.pr is also read by its worker-pr panel.
# Usage: orc-label phase <phase> [<ticket key>]   sets orc.phase and orc.at.<phase> (now, epoch seconds), clears orc.stopped;
#                                                 with a key, also orc.ticket; phase spec also resets orc.round to 0
#        orc-label stop "<reason>"                sets orc.stopped
#        orc-label round <n>                      sets orc.round
#        orc-label pr <PR URL>                    sets orch.pr
# Phases must match the panel's phase list: an unknown one would show there as spec.
set -euo pipefail

PHASES=(spec build review ship ci ticket finish "done")
me="${HC_TERMINAL_ID:?HC_TERMINAL_ID is not set: run orc inside herdr-core}"
die() {
  echo "orc-label: $*" >&2
  exit 1
}

case "${1:-}" in
  phase)
    p="${2:-}"
    [[ "$p" =~ ^[a-z]+$ && " ${PHASES[*]} " == *" $p "* ]] || die "unknown phase '$p': want one of ${PHASES[*]}"
    labels=("orc.phase=$p" "orc.at.$p=$(date +%s)" "orc.stopped=")
    [ -n "${3:-}" ] && labels+=("orc.ticket=$3")
    [ "$p" = spec ] && labels+=("orc.round=0")
    ;;
  stop)
    [ -n "${2:-}" ] || die 'usage: orc-label stop "<reason>"'
    labels=("orc.stopped=$2")
    ;;
  round)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || die "round wants a number, got '${2:-}'"
    labels=("orc.round=$2")
    ;;
  pr)
    [[ "${2:-}" =~ ^https://github\.com/[^/]+/[^/]+/pull/[0-9]+$ ]] || die "pr wants a GitHub PR URL, got '${2:-}'"
    labels=("orch.pr=$2")
    ;;
  *) die "usage: orc-label phase|stop|round|pr ..." ;;
esac

hc label "$me" "${labels[@]}" >/dev/null
